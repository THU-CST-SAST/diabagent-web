---
/**
 * The APC structure, with every step listed. Picking a step highlights its path
 * in the figure.
 */
import type { Lang } from "@/lib/i18n";

const lang = Astro.currentLocale as Lang;
const copy = {
  zh: {
    steps: [
      { title: "观察", body: "传感器读数和本人报告经由监测传给智能体。" },
      { title: "决策", body: "回顾近期读数、仍在起效的胰岛素和个人记录，并说明理由。" },
      { title: "行动", body: "在当前设备支持的操作中选择一个执行。" },
      { title: "响应", body: "身体在数小时内作出反应。评分依据真实状态，智能体无法直接观测。" },
      { title: "重新评估", body: "确定下次查看的时间和应提前唤醒它的事件，并更新笔记。" },
    ],
    label: "在智能体内部，监测把控制权交给决策，决策使用个人记录并调用设备工具。工具操作设备，设备作用于身体，传感器读数返回监测。评分直接依据身体的真实状态。",
    observe: "观察",
    act: "行动",
    monitoring: "监测",
    decision: "决策",
    tools: "设备工具",
    record: "个人记录",
    devices: "设备：泵、笔、CGM、血糖仪",
    body: "身体：隐藏状态",
    score: "评分",
  },
  en: {
    steps: [
      { title: "Observe", body: "Sensor readings and the person's reports reach the agent through monitoring." },
      { title: "Decide", body: "It reviews recent readings, insulin still acting and the personal record, then states its reason." },
      { title: "Act", body: "It performs one operation that the current device supports." },
      { title: "Respond", body: "The body responds over hours. The score uses the true state, which the agent cannot observe directly." },
      { title: "Reassess", body: "It sets the next check and the events that should wake it sooner, and updates its notes." },
    ],
    label: "Inside the agent, monitoring hands control to decision making, which uses a personal record and calls device tools. Tools operate the devices, devices act on the body, and sensor readings return to monitoring. The score uses the body's true state.",
    observe: "observe",
    act: "act",
    monitoring: "Monitoring",
    decision: "Decision",
    tools: "Device tools",
    record: "Personal record",
    devices: "Devices: pump, pen, CGM, meter",
    body: "Body: hidden state",
    score: "Score",
  },
}[lang];
const { steps } = copy;
---

<div class="da-apc" data-apc>
  <svg class="da-apc-figure" viewBox="0 0 640 452" role="img" aria-label={copy.label}>
    <defs>
      <marker id="da-apc-tip" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0 10 5 0 10z" fill="#6e757b"></path>
      </marker>
      <marker id="da-apc-tip-on" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
        <path d="M0 0 10 5 0 10z" fill="#16191c"></path>
      </marker>
    </defs>

    <rect class="da-apc-agent" x="14" y="12" width="612" height="240"></rect>
    <text class="da-apc-group" x="36" y="50">DiabAgent</text>

    <path class="da-apc-edge" data-on="5" d="M302 70 Q220 26 138 70" marker-end="url(#da-apc-tip)"></path>
    <path class="da-apc-edge" data-on="1" d="M200 105h38" marker-end="url(#da-apc-tip)"></path>
    <path class="da-apc-edge" data-on="3" d="M400 105h38" marker-end="url(#da-apc-tip)"></path>
    <path class="da-apc-edge" data-on="2 5" d="M320 170v-28" marker-end="url(#da-apc-tip)" marker-start="url(#da-apc-tip)"></path>
    <path class="da-apc-edge" data-on="1" d="M120 290V142" marker-end="url(#da-apc-tip)"></path>
    <path class="da-apc-edge" data-on="3" d="M520 140v148" marker-end="url(#da-apc-tip)"></path>
    <path class="da-apc-edge" data-on="4" d="M320 346v28" marker-end="url(#da-apc-tip)"></path>
    <path class="da-apc-edge" data-on="1" d="M120 376v-28" marker-end="url(#da-apc-tip)"></path>
    <path class="da-apc-edge is-dashed" data-on="4" d="M430 404h38" marker-end="url(#da-apc-tip)"></path>

    <text class="da-apc-verb" x="132" y="276">{copy.observe}</text>
    <text class="da-apc-verb" x="508" y="276" text-anchor="end">{copy.act}</text>

    <g class="da-apc-node" data-on="1 5">
      <rect x="40" y="70" width="160" height="70"></rect>
      <text x="120" y="113" text-anchor="middle">{copy.monitoring}</text>
    </g>
    <g class="da-apc-node" data-on="2">
      <rect x="240" y="70" width="160" height="70"></rect>
      <text x="320" y="113" text-anchor="middle">{copy.decision}</text>
    </g>
    <g class="da-apc-node" data-on="3">
      <rect x="440" y="70" width="160" height="70"></rect>
      <text x="520" y="113" text-anchor="middle">{copy.tools}</text>
    </g>
    <g class="da-apc-node" data-on="2 5">
      <rect x="220" y="172" width="200" height="60"></rect>
      <text x="320" y="210" text-anchor="middle">{copy.record}</text>
    </g>
    <g class="da-apc-node" data-on="1 3">
      <rect x="40" y="290" width="560" height="56"></rect>
      <text x="320" y="326" text-anchor="middle">{copy.devices}</text>
    </g>
    <g class="da-apc-node is-body" data-on="4">
      <rect x="40" y="376" width="390" height="60"></rect>
      <text x="235" y="414" text-anchor="middle">{copy.body}</text>
    </g>
    <g class="da-apc-node is-score" data-on="4">
      <rect x="470" y="376" width="130" height="60"></rect>
      <text x="535" y="414" text-anchor="middle">{copy.score}</text>
    </g>
  </svg>

  <ol class="da-apc-steps">
    {
      steps.map((step, index) => (
        <li data-step class:list={[index === 0 && "is-active"]}>
          <button type="button" aria-pressed={index === 0 ? "true" : "false"}>
            <span class="da-apc-index">{index + 1}</span>
            <span class="da-apc-title">{step.title}</span>
          </button>
          <p>{step.body}</p>
        </li>
      ))
    }
  </ol>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-apc]").forEach((root) => {
    const steps = [...root.querySelectorAll<HTMLElement>("[data-step]")];
    const marks = [...root.querySelectorAll<SVGElement>("[data-on]")];

    const show = (index: number) => {
      steps.forEach((step, i) => {
        step.classList.toggle("is-active", i === index);
        step.querySelector("button")!.setAttribute("aria-pressed", String(i === index));
      });
      marks.forEach((mark) => {
        const on = mark.dataset.on!.split(" ").includes(String(index + 1));
        mark.classList.toggle("is-on", on);
        // Markers cannot inherit a stroke everywhere, so swap the arrowhead too.
        const tip = `url(#da-apc-tip${on ? "-on" : ""})`;
        if (mark.hasAttribute("marker-end")) mark.setAttribute("marker-end", tip);
        if (mark.hasAttribute("marker-start")) mark.setAttribute("marker-start", tip);
      });
    };

    show(0);
    steps.forEach((step, index) => {
      step.querySelector("button")!.addEventListener("click", () => show(index));
    });
  });
</script>
