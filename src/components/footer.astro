---
import Container from "@/components/container.astro";
import { Icon } from "astro-icon/components";
import { projectPath } from "@/lib/project-paths";

const year = new Date().getFullYear();
---

<footer class="mt-24 bg-dark text-on-dark">
  <Container class="py-14">
    <div
      class="flex flex-col md:flex-row md:items-start md:justify-between gap-8">
      <div class="flex flex-col gap-3">
        <a href={projectPath('/')} class="flex items-center gap-2 w-fit">
          <img src={projectPath('/brand/sast.png')} width="28" height="28" alt="SAST" class="shrink-0 object-contain" />
          <span class="font-serif font-bold tracking-tight text-[15px]"
            >THU CST SAST</span
          >
        </a>
      </div>

      <nav class="flex flex-wrap gap-x-8 gap-y-3 text-sm">
        <a href={projectPath('/')} class="text-ink-4 hover:text-on-dark transition">Home</a>
        <a href={projectPath('/research')} class="text-ink-4 hover:text-on-dark transition">Research</a>
        <a href={projectPath('/about')} class="text-ink-4 hover:text-on-dark transition">About</a>
        <a
          href="https://github.com/Einsia"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1.5 text-ink-4 hover:text-on-dark transition">
          <Icon name="bx:bxl-github" class="w-4 h-4" />
          GitHub
        </a>
      </nav>
    </div>

    <div
      class="mt-12 pt-6 border-t border-white/10 text-xs text-ink-3">
      &copy; {year} THU CST SAST. Benchmark. Build. Break.
    </div>
  </Container>
</footer>
