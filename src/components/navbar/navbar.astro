---
import Container from "@/components/container.astro";
import { projectPath } from "@/lib/project-paths";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";

interface Props {
  linkBase?: string;
  activePath?: string;
}
const { linkBase = import.meta.env.BASE_URL.replace(/\/$/, ""), activePath } = Astro.props;
const hrefFor = (path: string) =>
  path === "/research" || path === "/about" ? `https://lab.einsia.ai${path}` :
  path.startsWith("/") ? `${linkBase}${path}` : path;

const menuitems = [
  { title: "Home", path: "/", external: false },
  { title: "Research", path: "/research", external: false },
  { title: "About", path: "/about", external: false },
  { title: "Einsia Home ↗", path: "https://einsia.ai/", external: true },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const localPath = base && Astro.url.pathname.startsWith(base + "/")
  ? Astro.url.pathname.slice(base.length)
  : Astro.url.pathname;
const pathname = activePath ?? (localPath.length > 1 ? localPath.replace(/\/$/, "") : localPath);

const isActive = (path: string) =>
  path === "/" ? pathname === "/" : pathname.startsWith(path);
---

<header
  class="sticky top-0 z-40 border-b border-line bg-paper/90 backdrop-blur-md">
  <Container>
    <div class="flex flex-col lg:flex-row justify-between items-center py-4">
      <Astronav>
        <div class="flex w-full lg:w-auto items-center justify-between">
          <a href={hrefFor("/")} class="flex items-center gap-2 group" aria-label="THU CST SAST — Einsia">
            <img src={projectPath('/brand/sast.png')} width="32" height="32" alt="SAST" class="shrink-0 object-contain" />
            <span
              class="font-serif font-bold tracking-tight text-ink text-xl group-hover:underline underline-offset-4">
              THU CST SAST
            </span>
          </a>
          <div class="block lg:hidden">
            <MenuIcon class="w-5 h-5 text-ink" />
          </div>
        </div>
        <MenuItems class="hidden w-full lg:w-auto mt-3 lg:flex lg:mt-0">
          <ul class="flex flex-col lg:flex-row lg:items-center lg:gap-1">
            {
              menuitems.map((item) => (
                <li>
                  <a
                    href={hrefFor(item.path)}
                    rel={item.external ? "home" : undefined}
                    class:list={[
                      "block px-3 py-2 rounded-md text-sm transition",
                      !item.external && isActive(item.path)
                        ? "text-ink font-semibold"
                        : "text-ink-2 hover:text-ink hover:bg-paper-2",
                    ]}>
                    {item.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </MenuItems>
      </Astronav>
    </div>
  </Container>
</header>
