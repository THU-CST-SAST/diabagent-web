---
import Container from "@/components/container.astro";
import { projectPath } from "@/lib/project-paths";
---
<header class="sticky top-0 z-40 border-b border-line bg-paper/90 backdrop-blur-md">
  <Container>
    <a href="https://net9.org/" class="flex w-full justify-between items-center gap-4 py-4 group" aria-label="THU CST SAST Homepage">
      <span class="flex items-center gap-2">
        <img src={projectPath('/brand/sast.png')} width="32" height="32" alt="SAST" class="shrink-0 object-contain" />
        <span class="font-serif font-bold text-ink text-xl">THU CST SAST</span>
      </span>
      <span class="text-sm text-ink-2 group-hover:underline underline-offset-4">Homepage ↗</span>
    </a>
  </Container>
</header>
