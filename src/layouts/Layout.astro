---
import Footer from "@/components/footer.astro";
import Navbar from "@/components/navbar/navbar.astro";
import { contentFor } from "@/lib/diabagent.js";
import { pageOf, pagePath, type Lang } from "@/lib/i18n";
import { projectPath } from "@/lib/project-paths";
import {
  getLabSeo,
  getLabStructuredData,
  LAB_SITE_NAME,
  LAB_SITE_URL,
  type LabSeo,
} from "@/lib/seo";
import "@fontsource-variable/inter";
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
}

const lang = Astro.currentLocale as Lang;
const { title, description = contentFor(lang).TITLE } = Astro.props;
const page = pageOf(Astro.url.pathname);

const configuredSeo = getLabSeo(Astro.url.pathname);
const fallbackTitle = title
  ? `${title} | ${LAB_SITE_NAME}`
  : LAB_SITE_NAME;
const seo: LabSeo = configuredSeo ?? {
  title: fallbackTitle,
  ogTitle: title || LAB_SITE_NAME,
  description,
  canonical: new URL(Astro.url.pathname, Astro.site).toString(),
  image: `${LAB_SITE_URL}/brand/sast.png`,
  imageAlt: "THU CST SAST",
  ogType: "website",
  schemaTypes: ["WebPage"],
};
const structuredData = getLabStructuredData(seo);
---

<!doctype html>
<html lang={lang === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4efe4" />
    <link rel="icon" type="image/png" href={projectPath('/brand/sast.png')} />
    <link rel="sitemap" href={projectPath('/sitemap-index.xml')} />
    <meta name="generator" content={Astro.generator} />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta
      name="robots"
      content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
    />
    <link rel="canonical" href={seo.canonical} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(pagePath("zh", page), Astro.site).toString()} />
    <link rel="alternate" hreflang="en" href={new URL(pagePath("en", page), Astro.site).toString()} />
    <meta property="og:locale" content={lang === "zh" ? "zh_CN" : "en_US"} />
    <meta property="og:type" content={seo.ogType} />
    <meta property="og:site_name" content={LAB_SITE_NAME} />
    <meta property="og:title" content={seo.ogTitle} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:image" content={seo.image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={seo.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.ogTitle} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.image} />
    <meta name="twitter:image:alt" content={seo.imageAlt} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body class="min-h-screen flex flex-col overflow-x-hidden">
    <Navbar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Lightbox: click any non-linked image to zoom -->
    <div
      id="lightbox"
      class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/80 p-4 sm:p-8 cursor-zoom-out"
      aria-hidden="true">
      <img
        id="lightbox-img"
        src=""
        alt=""
        class="max-w-full max-h-full object-contain rounded-lg bg-white"
      />
    </div>

    <style is:global>
      img {
        content-visibility: auto;
      }
    </style>

    <script>
      (function () {
        const box = document.getElementById("lightbox");
        const boxImg = document.getElementById(
          "lightbox-img"
        ) as HTMLImageElement | null;
        if (!box || !boxImg) return;

        const open = (src: string, alt: string) => {
          boxImg.src = src;
          boxImg.alt = alt;
          box.classList.remove("hidden");
          box.classList.add("flex");
          document.body.style.overflow = "hidden";
        };
        const close = () => {
          box.classList.add("hidden");
          box.classList.remove("flex");
          boxImg.removeAttribute("src");
          document.body.style.overflow = "";
        };

        document.querySelectorAll<HTMLImageElement>("main img").forEach((img) => {
          if (img.closest("a")) return; // image is a link → leave it
          img.style.cursor = "zoom-in";
          img.addEventListener("click", () =>
            open(img.currentSrc || img.src, img.alt)
          );
        });

        box.addEventListener("click", close);
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") close();
        });
      })();
    </script>
  </body>
</html>
